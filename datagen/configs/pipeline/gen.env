# gen -- step 2, scene-free Kimodo sit motion (250 shards x 200 = 50k); docs/data_pipeline.md
# launch/run_stage.sh gen [prod|eval] --shard <i> --num-shards <n>    1 GPU, 200 GB disk, 24h, preemptible OK

STAGE_GPUS=1
STAGE_NODES=1
STAGE_SETUP='bash motion_gen/pod/setup_kimodo.sh'
STAGE_CMD='bash motion_gen/pod/run_kimodo_sit_syn.sh'

SINGLE_STANDING_KF='standpose'
TURN_NF='50'
SPEC_S3_PATH='halo_sit_n50k/specs'
SHARD_ID='0'
TOTAL_SHARDS='250'
EPS_PER_SHARD='200'
SEED_BASE='0'
N_MAX_RETRY='5'
BATCH='16'
TIER='industry'
STEPS='200'
ROBOT_VARIANT='g1_29dof_thor'
CAM_KIND='fisheye'
VDR_LEVEL='light'
ASSET_COLOR='default'
CHAIR_SET='pair'
SLOW_RADIUS='0.2'

case "${VARIANT:=prod}" in
    prod) ;;
    eval) SINGLE_STANDING_KF='eval'; SPEC_S3_PATH='halo_sit_eval_n50k/specs' ;;
    *) echo "gen: VARIANT must be prod or eval" >&2; return 1 ;;
esac
STAGE_TAG="gen_$VARIANT"
