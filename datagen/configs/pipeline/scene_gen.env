# scene_gen -- step 1, Infinigen scenes + bake + scene analysis: single = single-room scenes (300 shards x 4), dual = dual-room (500 x 2)
# launch/run_stage.sh scene_gen [single|dual] --shard <i> --num-shards <n> [LIGHT_GAIN=2.0]    1 NVIDIA GPU, ~60 GB RAM, 300 GB disk
# The paper's scenes used LIGHT_GAIN=2.0 for every scene; unset, each scene uses its manifest light_gain (dual: none, so 2.0).

STAGE_GPUS=1
STAGE_NODES=1
STAGE_SETUP='bash scene_gen/env/setup_scene_gen.sh'
STAGE_CMD='bash scene_gen/pod/run_shard.sh'

NVIDIA_DRIVER_CAPABILITIES='all'
SHARD_IDX='0'
BLENDER_DIR='/opt/blender52'
INFINIGEN_ROOT='/opt/infinigen_src'
INFINIGEN_ENV='/opt/infinigen_env'
BAKE_SPP='128'
BAKE_MAXRES='4096'
N_INTERIOR_VIEWS='48'
N_ORBIT_VIEWS='16'
N_PROJ_VIEWS='8'
PROJ_SS='4'
GT_SPP='128'
RENDER_RES='1000x625'
GEN_WORKERS='0'
GEN_TIMEOUT_S='18000'
GEN_MEM_FLOOR_GB='60'
GEN_DISK_FLOOR_GB='40'
GEN_MAX_READY='3'
BUDGET_S='75600'
ROLLING_UPLOAD_SECS='180'

case "${VARIANT:=single}" in
    single) TOTAL_SHARDS='300'; SET='single'; MANIFEST="${HALO_REPO}/scene_gen/spec/scenes_single.json" ;;
    dual) TOTAL_SHARDS='500'; SET='dual'; MANIFEST="${HALO_REPO}/scene_gen/spec/scenes_dual.json"; NO_ROOM_RESTRICT='1' ;;
    *) echo "scene_gen: VARIANT must be single or dual" >&2; return 1 ;;
esac
OUT_S3="${HALO_S3_ROOT}/scenes/$SET"
STAGE_TAG="scene_gen_$VARIANT"
unset SET
