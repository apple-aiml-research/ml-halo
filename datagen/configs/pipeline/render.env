# render -- step 3, se2_fit placement + THOR/OAK/TPV render with visual DR (250 shards x 200); docs/data_pipeline.md
# launch/run_stage.sh render [prod|eval|mujoco] [SCENES=1|10|100|1000] --shard <i> --num-shards <n>
# 1 NVIDIA RTX GPU, 500 GB disk

STAGE_GPUS=1
STAGE_NODES=1
STAGE_SETUP='bash render/pod/setup_render_gpu.sh'
STAGE_CMD='bash render/pod/run_render_isaac.sh'

NVIDIA_DRIVER_CAPABILITIES='all'
SCENE_S3_PATH='scenes/single'
SCENES_PER_SHARD='4'
SPEC_S3_PATH='halo_sit_n50k/specs'
# RENDER_BATCH is a seed string (placement + visual DR per episode); the values below reproduce the paper data
RENDER_BATCH='motionfirst_sit_prod_sp_turn50_v7_n50k'
SHARD_IDX='0'
TOTAL_SHARDS='250'
EPS_PER_SHARD='200'
TARGET_FPS='30'
ROLLING_UPLOAD_SECS='120'
ROLLBACK_EPS='2'

case "${SCENES:=1000}" in
    1000) SC='' ;;
    1|10|100) SC="_scene$SCENES" ;;
    *) echo "render: SCENES must be 1, 10, 100 or 1000" >&2; return 1 ;;
esac
SCENE_MANIFEST="common/manifests/render_scenes_$SCENES.txt"
case "${VARIANT:=prod}" in
    prod) DIRECT_WRITE_DEST="halo_sit${SC}_n50k"; RENDER_BATCH="motionfirst_sit_prod_sp_turn50_v7${SC}_n50k" ;;
    # one RENDER_BATCH for every eval scene count, so their DR seeds match
    eval) SPEC_S3_PATH='halo_sit_eval_n50k/specs'; DIRECT_WRITE_DEST="halo_sit_eval${SC}_n50k"; RENDER_BATCH='mf_eval_sit_v7_n50k' ;;
    # prod's RENDER_BATCH, so the same placements; resume state goes to rendered_output/<batch>_mujoco
    mujoco)
        STAGE_SETUP='bash render/pod/setup_render_cpu.sh'; STAGE_CMD='bash render/pod/run_render_mujoco.sh'
        DIRECT_WRITE_DEST="halo_sit_mujoco${SC}_n50k"; RENDER_BATCH="motionfirst_sit_prod_sp_turn50_v7${SC}_n50k"
        MUJOCO_GL='egl' ;;
    *) echo "render: VARIANT must be prod, eval or mujoco" >&2; return 1 ;;
esac
STAGE_TAG="render_$VARIANT${SC:+.scene$SCENES}"
unset SC
